# 用法：把本文件复制为 .env.local 再填值。
# 重要：Next.js 只加载 .env.local / .env / .env.development(.local)，
# 不要把真实密钥直接写在本文件里——它不会生效，而且容易被提交到仓库。

# ==== 对话模型（OpenAI 兼容协议）====
#   DeepSeek        https://api.deepseek.com/v1          deepseek-chat
#   智谱 GLM        https://open.bigmodel.cn/api/paas/v4  glm-4-flash / glm-4-plus
#   阿里通义百炼     https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
#   月之暗面 Kimi    https://api.moonshot.cn/v1           moonshot-v1-8k
#   硅基流动        https://api.siliconflow.cn/v1         Qwen/Qwen2.5-72B-Instruct
#   Ollama 本地     http://localhost:11434/v1             qwen2.5:7b
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-chat
CHAT_TEMPERATURE=0.2
CHAT_MAX_TOKENS=2048

# ==== 向量化模型（Embedding）====
# 留空则复用上面的 OPENAI_API_KEY / OPENAI_BASE_URL。
# EMBEDDING_MODEL 留空时按 BASE_URL 自动推断：
#   智谱→embedding-3、硅基流动→BAAI/bge-m3、百炼→text-embedding-v3、
#   OpenAI→text-embedding-3-small、Ollama→nomic-embed-text
# 注意：DeepSeek 没有 embedding 接口，用 DeepSeek 对话时需单独指向一家能提供 embedding 的服务。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# ==== RAG 参数 ====
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.25

# ==== 数据目录（默认项目下 .data）====
# DATA_DIR=
